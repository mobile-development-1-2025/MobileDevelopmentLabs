<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PrivateMessengerApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/card_bg_color</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog_Background" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/card_bg_color</item>
        <item name="colorOnSurface">@color/title</item>
        <item name="colorOnSurfaceVariant">@color/subtitle</item>
    </style>

    <style name="Theme.PrivateMessengerApp" parent="Base.Theme.PrivateMessengerApp" />

    <style name="EditTextHint_12sp" parent="TextAppearance.Design.Hint">
        <item name="android:textSize">@dimen/_12sp</item>
    </style>

    <style name="EditTextError_10sp" parent="TextAppearance.Design.Error">
        <item name="android:textSize">@dimen/_10sp</item>
    </style>

    <style name="MineCustomSelectedTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/black</item>
    </style>

    <style name="MineCustomNotSelectedTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>
</resources>