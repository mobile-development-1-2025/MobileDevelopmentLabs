<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.chat.ChatFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_50dp"
        android:paddingBottom="@dimen/_8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/input_layout"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:listitem="@layout/item_sent_text_message" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_color_variant"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="@dimen/_60dp"
            android:layout_height="@dimen/_60dp"
            android:padding="@dimen/_16dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/peer_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6dp"
            android:fontFamily="@font/semi_bold"
            android:textColor="@color/white"
            android:textSize="@dimen/_20sp"
            app:layout_constraintBottom_toBottomOf="@id/back_btn"
            app:layout_constraintStart_toEndOf="@id/back_btn"
            app:layout_constraintTop_toTopOf="@id/back_btn"
            tools:text="Peer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar_color_variant"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_60dp"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/input"
                android:layout_width="@dimen/_0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:cursorVisible="true"
                android:fontFamily="@font/regular"
                android:gravity="center_vertical"
                android:hint="@string/message"
                android:imeOptions="actionDone"
                android:inputType="text|textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="@dimen/_60dp"
                android:paddingVertical="@dimen/_8dp"
                android:paddingStart="@dimen/_20dp"
                android:paddingEnd="@dimen/_12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/edittext_hint_color"
                android:textCursorDrawable="@drawable/cursor_drawable"
                android:textSize="@dimen/_18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/send_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/send_btn"
                android:layout_width="@dimen/_60dp"
                android:layout_height="@dimen/_60dp"
                android:padding="@dimen/_14dp"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/voice_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/sent_message_icon_color" />

            <ImageView
                android:id="@+id/file_btn"
                android:layout_width="@dimen/_60dp"
                android:layout_height="@dimen/_60dp"
                android:padding="@dimen/_14dp"
                android:src="@drawable/ic_attach"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/photo_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray" />

            <com.devlomi.record_view.RecordButton
                android:id="@+id/voice_btn"
                android:layout_width="@dimen/_60dp"
                android:layout_height="@dimen/_60dp"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_mic"
                tools:ignore="MissingConstraints" />

            <com.devlomi.record_view.RecordView
                android:id="@+id/record_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="70dp"
                android:layout_toLeftOf="@id/voice_btn"
                app:cancel_text_color="@color/white"
                app:counter_time_color="@color/white"
                app:slide_to_cancel_arrow="@drawable/recv_ic_arrow"
                app:slide_to_cancel_arrow_color="@color/white"
                app:slide_to_cancel_bounds="8dp"
                app:slide_to_cancel_margin_right="70dp"
                app:slide_to_cancel_text="Slide To Cancel"
                tools:ignore="MissingConstraints" />

            <ImageView
                android:id="@+id/photo_btn"
                android:layout_width="@dimen/_60dp"
                android:layout_height="@dimen/_60dp"
                android:padding="@dimen/_14dp"
                android:src="@drawable/ic_photo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/voice_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>