<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        # header
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Лента"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        # cat
        <androidx.cardview.widget.CardView
            android:id="@+id/card1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView android:id="@+id/iv_avatar1"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_cat_hero"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tv_author1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Мурзик из 5-го подъезда"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView android:id="@+id/tv_message1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Спас голубя от соседского пса! Теперь жду медаль и бесконечный корм "
                        android:textSize="15sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tv_time1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="· 5 минут назад"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        # raccoon
        <androidx.cardview.widget.CardView
            android:id="@+id/card2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/card1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView android:id="@+id/iv_avatar2"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_raccoon"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tv_author2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Енот Степан"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView android:id="@+id/tv_message2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В 3:14 ночи успешно взломал холодильник. Добыча: целый торт и полбанки сгущёнки. Подозреваемых нет."
                        android:textSize="15sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tv_time2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="· 42 минуты назад"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        # hamster
        <androidx.cardview.widget.CardView
            android:id="@+id/card3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/card2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView android:id="@+id/iv_avatar3"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_hamster"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tv_author3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Хомяк Кеша"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView android:id="@+id/tv_message3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Наконец-то собрал все орешки! 48 часов без сна, 3 кг семечек — но оно того стоило!"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tv_time3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="· 1 час назад"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>